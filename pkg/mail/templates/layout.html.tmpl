<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Title}}</title>
<style>
@media (prefers-color-scheme: dark) {
  .canvas { background-color: #141414 !important; }
  .band { background-color: #1f1f1f !important; }
  .panel { background-color: #181818 !important; }
  .panel-border { border-color: #2a2a2a !important; }
  .icon-tile { border-color: #2a2a2a !important; }
  .fg { color: #f5f5f5 !important; }
  .muted { color: #a3a3a3 !important; }
  .well { background-color: #222222 !important; }
}
</style>
</head>
<body class="canvas" style="margin:0;padding:0;background:#ffffff;">
<div style="display:none;max-height:0;overflow:hidden;">{{.Preheader}}</div>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="canvas" style="background:#ffffff;">
  <tr>
    <td style="padding:32px 16px;">
      {{.MSOTableOpen}}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:480px;margin:0 auto;">
        <tr>
          <td class="band" style="background:#f5f5f5;border-radius:22px;padding:6px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td style="padding:10px 14px 12px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      {{if .IconSrc}}<td width="40" valign="middle" style="padding:0 12px 0 0;">
                        <img src="{{.IconSrc}}" width="40" height="40" alt="" class="icon-tile" style="display:block;width:40px;height:40px;border-radius:10px;background:#ffffff;border:1px solid #e8e8e8;">
                      </td>{{end}}
                      <td valign="middle" class="fg" style="font:600 15px/20px -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans SC',Roboto,Helvetica,Arial,sans-serif;color:#262626;">{{.Instance}}</td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td class="panel panel-border" style="background:#ffffff;border:1px solid #e8e8e8;border-radius:16px;padding:28px 24px;">
                  <h1 class="fg" style="margin:0 0 8px;font:600 20px/28px -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans SC',Roboto,Helvetica,Arial,sans-serif;color:#262626;">{{.Heading}}</h1>
                  <p class="fg" style="margin:0 0 20px;font:400 15px/24px -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans SC',Roboto,Helvetica,Arial,sans-serif;color:#262626;">{{.Lead}}</p>
                  {{if .Code}}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                    <tr>
                      <td class="well fg" style="background:#f5f5f5;border-radius:14px;padding:16px 20px;font:600 32px/40px ui-monospace,'SF Mono',Menlo,Consolas,'Liberation Mono',monospace;letter-spacing:6px;color:#262626;">{{.Code}}</td>
                    </tr>
                  </table>
                  <p class="muted" style="margin:12px 0 0;font:400 14px/20px -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans SC',Roboto,Helvetica,Arial,sans-serif;color:#676767;">{{.Validity}}</p>
                  {{end}}
                  <p class="muted" style="margin:24px 0 0;font:400 14px/20px -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans SC',Roboto,Helvetica,Arial,sans-serif;color:#676767;">{{.Note}}</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      {{.MSOTableClose}}
    </td>
  </tr>
</table>
</body>
</html>
